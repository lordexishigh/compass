{
  "name": "@compass/seed-snapshot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The seeded organization as an AnalysisSnapshot for any (team, instant): the fixture the analysis tests, the golden suite and the determinism gate all build from.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
