    "test:watch": "vitest"
  },
  "dependencies": {
    "@compass/analysis": "workspace:*",
    "@compass/clock": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
