{
  "name": "@compass/renderers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renderers over one structured report: six sections, fixed order, prose only.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@compass/analysis": "workspace:*",
    "@compass/clock": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
