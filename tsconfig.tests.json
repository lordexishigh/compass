{
  // Type-checks every test suite that resolves modules the Node way (NodeNext).
  //
  // `apps/web/tests` is deliberately absent: that app compiles under
  // `moduleResolution: Bundler` with the `@/*` alias, so its tests are authored
  // extensionless and are checked by `apps/web/tsconfig.json` instead — see the
  // `typecheck` script in `apps/web/package.json`, which the root `typecheck`
  // runs. Checking them here as well would demand `.js` suffixes that the
  // Next.js compiler does not want.
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@compass/clock": ["packages/clock/src/index.ts"],
      "@compass/connector-port/testkit": ["packages/connector-port/src/testkit/index.ts"],
      "@compass/connector-port": ["packages/connector-port/src/index.ts"],
      "@compass/seed-connector": ["packages/seed-connector/src/index.ts"],
      "@compass/db/testing": ["packages/db/src/testing/pglite.ts"],
      "@compass/db": ["packages/db/src/index.ts"],
      "@compass/auth": ["packages/auth/src/index.ts"],
      "@compass/knowledge-model": ["packages/knowledge-model/src/index.ts"],
      "@compass/memos": ["packages/memos/src/index.ts"],
      "@compass/ingest": ["packages/ingest/src/index.ts"],
      "@compass/analysis": ["packages/analysis/src/index.ts"],
      "@compass/renderers": ["packages/renderers/src/index.ts"],
      "@compass/delivery/testkit": ["packages/delivery/src/testkit/index.ts"],
      "@compass/delivery": ["packages/delivery/src/index.ts"],
      "@compass/narrator/testkit": ["packages/narrator/src/testkit/index.ts"],
      "@compass/narrator": ["packages/narrator/src/index.ts"],
      "@compass/pipeline": ["packages/pipeline/src/index.ts"],
      "@compass/smoke": ["tools/smoke/src/index.ts"]
    }
  },
  "include": [
    "vitest.shared.ts",
    "packages/*/vitest.config.ts",
    "packages/*/tests/**/*.ts",
    "apps/*/vitest.config.ts",
    "apps/worker/tests/**/*.ts",
    "tools/quality-gates/vitest.config.ts",
    "tools/quality-gates/tests/**/*.ts",
    "tools/smoke/vitest.config.ts",
    "tools/smoke/tests/**/*.ts"
  ],
  "exclude": ["tools/quality-gates/fixtures/**"]
}
