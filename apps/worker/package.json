    "@compass/ingest": "workspace:*",
    "@compass/jira-connector": "workspace:*",
    "@compass/knowledge-model": "workspace:*",
    "@compass/narrator": "workspace:*",
    "@compass/observability": "workspace:*",
    "@compass/pipeline": "workspace:*",
    "@compass/seed-connector": "workspace:*",
    "@compass/slack-connector": "workspace:*",
    "@compass/trust": "workspace:*",
    "@sentry/node": "^10.70.0",
    "pg-boss": "12.27.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@compass/analysis": "workspace:*",
    "@compass/renderers": "workspace:*",
