# ---------------------------------------------------------------------------
# Compass — local defaults. Copy to .env; no secret is required for cold start.
# ---------------------------------------------------------------------------

# Pooled application connection (transaction-mode pooler in production).
DATABASE_URL=postgresql://compass:compass@localhost:5432/compass

# Direct session connection. Migrations, advisory locks and pg-boss maintenance
# MUST use this one: role/session DDL cannot run through a transaction pooler.
DATABASE_URL_DIRECT=postgresql://compass:compass@localhost:5432/compass

# IANA timezone used when a team has no working calendar configured yet.
COMPASS_DEFAULT_TIMEZONE=Europe/London

# Narration is optional. Absent, reports render through the deterministic
# template renderer and say so.
# ANTHROPIC_API_KEY=

# Delivery channels are optional at this stage of the build.
# RESEND_API_KEY=
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
